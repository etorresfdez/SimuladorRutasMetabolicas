void __fastcall TForm1::ComboMostrarReaccionChange(TObject *Sender)
{
    if (!datosValidados) // datos no validados
	{
		DialogPrimeroValida->Execute();
	}
	else
	{
		// coge la seleccion del combobox
		String key = ComboMostrarReaccion->Text;

		// si se ha seleccionado la opcion "Todas", muestra las ecuaciones cineticas de todas las reacciones del modelo
		if (key == "Todas")
		{
			for (int i=0; i< model.getNMechanisms(); i++)
