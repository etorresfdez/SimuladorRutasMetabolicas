void __fastcall TForm1::StringGridDrawCell(TObject *Sender, System::LongInt ACol,
		  System::LongInt ARow, TRect &Rect, TGridDrawState State)
{
	TStringGrid *Grid = dynamic_cast<TStringGrid*>(Sender);
	if (!Grid) return;

	// Edita las celdas de la primera fila o la primera columna
    if (ACol == 0 || ARow == 0)
	{
		// 1. Pinta el color de fondo
		Grid->Canvas->Brush->Color = TColor(RGB(255, 239, 213)); // papaya whip
		Grid->Canvas->FillRect(Rect);

		// 2. Configura el estilo del texto
		Grid->Canvas->Font->Color = clBlack;
		Grid->Canvas->Font->Style = TFontStyles() << fsBold;

		// 3. Obtiene el texto de la celda actual
		String textoCelda = Grid->Cells[ACol][ARow];

		// 4. Dibuja el texto explicitamente (con margen de 4 pixeles)
		Grid->Canvas->TextRect(Rect, Rect.Left + 4, Rect.Top + 4, textoCelda);
	}
}

