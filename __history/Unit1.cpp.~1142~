__fastcall TForm1::TForm1(TComponent* Owner)
	: TForm(Owner)
{
	// inicializa objetos modelo y simulacion
	model = TModel();
	simulation = TSimulation();

	// inicializa variables bandera
	entradaVacia = true;
	datosValidados = false;

	// rellena los combobox con los mecanismos y metodos numericos disponibles
	model.fillMechanismComboBox(ComboInsertarMecanismo);
	simulation.fillNumericMethodComboBox(ComboEleccionMetodo);
}

//---------------------------------------------------------------------------
void __fastcall TForm1::FormResize(TObject *Sender)
{
	int half = ClientWidth / 2;

	// seccion entrada de datos
	PanelEntradaDatos->SetBounds(
		0,             // left
		0,             // top
		half,          // width
		ClientHeight   // height
	);
	MemoTextoEntrada->SetBounds(
		0,
		PanelEntradaDatos->BoundsRect.Bottom + 5,
		PanelEntradaDatos->ClientWidth,
		MemoTextoEntrada->Height
	);
    Splitter1->Top = MemoTextoEntrada->BoundsRect.Bottom;
	GridBotonesEntrada->SetBounds(
		0,
		Splitter1->BoundsRect.Bottom + 5,
		PanelEntradaDatos->ClientWidth,
		120
	);
	MemoSalidaValidacion->SetBounds(
		0,
		GridBotonesEntrada->BoundsRect.Bottom + 5,
		PanelEntradaDatos->ClientWidth,
		ClientHeight - (GridBotonesEntrada->BoundsRect.Bottom + 5)
	);

	// seccion simulacion
	PanelSimulacion->SetBounds(
		half +5,
		0,
		half -5,
		ClientHeight/5
	);
	GridBotonesSimulacion->SetBounds(
		0,
		LabelSimulacion->BoundsRect.Bottom + 5,
		PanelSimulacion->ClientWidth,
		PanelSimulacion->ClientHeight - LabelSimulacion->ClientHeight - 10
	);

	// seccion salida datos
	PanelSalidaDatos->SetBounds(
		half +5,
		PanelSimulacion->BoundsRect.Bottom + 5,
		half -5,
		ClientHeight - (PanelSimulacion->BoundsRect.Bottom + 5)
	);
	MemoSalidaSimTexto->SetBounds(
		0,
		LabelSalida->BoundsRect.Bottom + 5,
		PanelSalidaDatos->ClientWidth,
		150
	);
	PageControlSalida->SetBounds(
        0,
		MemoSalidaSimTexto->BoundsRect.Bottom + 5,
		PanelSalidaDatos->ClientWidth,
		PanelSalidaDatos->ClientHeight - (MemoSalidaSimTexto->BoundsRect.Bottom)
	);
    PageControlSalida->ActivePage = Tabla;

	// botones de informacion pegados a sus respectivos botones
	infoMeta->Left = BtnMetabolito->Left + BtnMetabolito->Width;
	infoParam->Left = BtnParametro->Left + BtnParametro->Width;
	infoReac->Left = BtnReaccion->Left + BtnReaccion->Width;
	infoMec->Left = ComboInsertarMecanismo->Left + ComboInsertarMecanismo->Width;
}

//---------------------------------------------------------------------------

void __fastcall TForm1::Splitter1CanResize(TObject *Sender, int &NewSize, bool &Accept)
{
    // establecemos un minimo y maximo para la altura de MemoTextoEntrada
	const int alturaMinimaMemo = 100;
	const int alturaMaximaMemo = PanelEntradaDatos->Height - 200;

    if (NewSize < alturaMinimaMemo)
		NewSize = alturaMinimaMemo;

	if (NewSize > alturaMaximaMemo)
		NewSize = alturaMaximaMemo;

	Accept = true;
}
//---------------------------------------------------------------------------

void __fastcall TForm1::Splitter1Moved(TObject *Sender)
{
	// Altura del Memo superior
	MemoTextoEntrada->Height = Splitter1->Top - MemoTextoEntrada->Top;

	// El Grid se desplaza, pero mantiene su altura
	GridBotonesEntrada->Top = Splitter1->BoundsRect.Bottom + 5;

	// El Memo inferior se desplaza y ocupa el espacio restante
	MemoSalidaValidacion->Top = Splitter1->BoundsRect.Bottom + GridBotonesEntrada->Height + 5;
	MemoSalidaValidacion->Height = PanelEntradaDatos->ClientHeight - MemoSalidaValidacion->Top;
}

//---------------------------------------------------------------------------
void __fastcall TForm1::SubirArchivoClick(TObject *Sender)
{
	// abre carpeta para subir archivo local
	if (DialogSubirArchivo->Execute())
	{
        try
        {
			// carga el contenido del archivo en MemoTextoEntrada
			MemoTextoEntrada->Lines->LoadFromFile(
				DialogSubirArchivo->FileName,
				TEncoding::UTF8
			);
        }
		catch (const Exception &e)
		{
            // muestra excepcion si se produce algun error de lectura
			ShowMessage("Error al cargar el archivo:\n" + e.Message);
        }
	}
}


//---------------------------------------------------------------------------
void __fastcall TForm1::NuevoArchivoClick(TObject *Sender)
{
	// crea cuadro dialogo
	TTaskDialog* DialogNuevoPanelEntrada = new TTaskDialog(this);
	DialogNuevoPanelEntrada->Caption = "Nuevo Panel Entrada de Datos";
	DialogNuevoPanelEntrada->Text = "Se borrará el contenido del panel de entrada de datos actual.";
	DialogNuevoPanelEntrada->CommonButtons = TTaskDialogCommonButtons();

	// botones personalizados
	TTaskDialogBaseButtonItem *btnAceptar = DialogNuevoPanelEntrada->Buttons->Add();
	btnAceptar->Caption = "Aceptar";

	TTaskDialogBaseButtonItem *btnCancelar = DialogNuevoPanelEntrada->Buttons->Add();
	btnCancelar->Caption = "Cancelar";

	// ejecuta el cuadro de dialogo
	if (DialogNuevoPanelEntrada->Execute())
	{
		int id = DialogNuevoPanelEntrada->ModalResult;

		// Aceptar -> borra directamente
		if (id == btnAceptar->ModalResult)
		{
			MemoTextoEntrada->Clear();
			MemoSalidaValidacion->Clear();
			datosValidados = false;
			entradaVacia = true;
		}
		// Cancelar -> no hace nada
	}
}

//---------------------------------------------------------------------------
void __fastcall TForm1::GuardarArchivoClick(TObject *Sender)
{
	// crea cuadro dialogo, solo permite guardar en formato txt
	TSaveDialog *SaveTextFileDialog = new TSaveDialog(this);
	SaveTextFileDialog->Filter = "Text files (*.txt)|*.txt";
	SaveTextFileDialog->DefaultExt = "txt";

    // al ejecutar, guarda el contenido en UTF-8
	if (SaveTextFileDialog->Execute())
		MemoTextoEntrada->Lines->SaveToFile(SaveTextFileDialog->FileName, TEncoding::UTF8);
}
