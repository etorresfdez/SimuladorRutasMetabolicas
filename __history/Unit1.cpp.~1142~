void __fastcall TForm1::BtnValidarDatosClick(TObject *Sender)
{
	// borra el contenido de MemoSalidaValidacion
	MemoSalidaValidacion->Lines->Clear();

	// se establece a true y cambia a false durante la funcion si ocurre algun error
	datosValidados = true;

	// reinicia los valores del modelo
	model.Clear();

	// lee cada linea del texto de entrada
	for (int i = 0; i < MemoTextoEntrada->Lines->Count; i++)
	{
		String line = Trim(MemoTextoEntrada->Lines->Strings[i]);

		// ignora lineas vacias
        if (line.IsEmpty())
			continue;

		// si empieza por METABOLITO
		if (UpperCase(line.SubString(1, 10)) == "METABOLITO")
		{
			entradaVacia = false;

			try
			{
				// crea un objeto metabolito llamando a su constructor
				TMetabolite metabolito(line);
				model.addMetabolite(metabolito);

				// muestra el metabolito encontrado
				//metabolito.toString(MemoSalidaValidacion);
			}
			catch (Exception &e)
			{
				// muestra excepcion en el texto de salida validacion
				MemoSalidaValidacion->Lines->Text = MemoSalidaValidacion->Lines->Text +
					"[Línea " + IntToStr(i+1) + "] " +
					"Error en lectura de METABOLITO: " + e.Message + "\n";
				datosValidados = false;
			}
		}
		else if (UpperCase(line.SubString(1, 9)) == "PARAMETRO")
		{
			entradaVacia = false;

			try
			{
				// crea un objeto parametro llamando a su constructor
				TParameter param(line);
				model.addParameter(param);

				// muestra el parametro encontrado
				//param.toString(MemoSalidaValidacion);
			}
			catch (Exception &e)
			{
				// muestra excepcion en el texto de salida validacion
				MemoSalidaValidacion->Lines->Text = MemoSalidaValidacion->Lines->Text +
					"[Línea " + IntToStr(i+1) + "] " +
					"Error en lectura de PARAMETRO: " + e.Message + "\n";
				datosValidados = false;
			}
		}
        else if (UpperCase(line.SubString(1, 8)) == "REACCION")
		{
			entradaVacia = false;

			try
			{
				// crea un objeto reaction llamando a su constructor
				TReaction reaction(line, &model);
				model.addReaction(reaction);

				// muestra el parametro encontrado
				//reaction.toString(MemoSalidaValidacion);
			}
			catch (Exception &e)
			{
				// muestra excepcion en el texto de salida validacion
				MemoSalidaValidacion->Lines->Text = MemoSalidaValidacion->Lines->Text +
					"[Línea " + IntToStr(i+1) + "] " +
					"Error en lectura de REACCION: " + e.Message + "\n";
                datosValidados = false;
			}
		}
		else if (UpperCase(line.SubString(1, 9)) == "MECANISMO")
		{
			entradaVacia = false;

			try
			{
                // Crea el objeto mecanismo segun el tipo que sea
				TMechanism mech = model.CreateMechanism(line, &model);
				model.addMechanism(mech);

				// muestra el mecanismo encontrado aplicado a una reaccion concreta
				//mech.toString(MemoSalidaValidacion);
			}
			catch (Exception &e)
			{
				// muestra excepcion en el texto de salida validacion
				MemoSalidaValidacion->Lines->Text = MemoSalidaValidacion->Lines->Text +
					"[Línea " + IntToStr(i+1) + "] " +
					"Error en lectura de MECANISMO: " + e.Message + "\n";
                datosValidados = false;
			}
		}
	}

	// el numero de reacciones y mecanismos registrados debe coincidir
	if (model.getNReactions() != model.getNMechanisms())
	{
		MemoSalidaValidacion->Lines->Add("[Error semántico]: El número de reacciones y mecanismos no coincide. Cada reacción debe tener un mecanismo asociado.");
		datosValidados = false;
	}

	// si los datos son validos y hay mecanismos
	if (datosValidados && (model.getNMechanisms() > 0))
	{
		//rellena el objeto combobox con las reacciones cargadas
		model.fillReactionsComboBox(ComboMostrarReaccion);
		// construye el sistema de ecuaciones
		model.BuildEquations();
	}

	// Mostrar el total de metabolitos, parametros, reacciones y mecanismos leidos
	if (!entradaVacia){
		MemoSalidaValidacion->Lines->Text = MemoSalidaValidacion->Lines->Text + "\n";
		MemoSalidaValidacion->Lines->Add("Elementos leídos correctamente:");
		MemoSalidaValidacion->Lines->Add("Total Metabolitos: " + IntToStr(model.getNMetabolites()));
		MemoSalidaValidacion->Lines->Add("Total Parámetros:  " + IntToStr(model.getNParameters()));
		MemoSalidaValidacion->Lines->Add("Total Reacciones: " + IntToStr(model.getNReactions()));
		MemoSalidaValidacion->Lines->Add("Total Mecanismos: " + IntToStr(model.getNMechanisms()));

		if (datosValidados)
		{
            // informacion para el usuario
			MemoSalidaValidacion->Lines->Add("");
			MemoSalidaValidacion->Lines->Add("DATOS VALIDADOS");
        }
	}
	else
	{
		// Avisar si no se ha introducido ningun dato
		DialogIntroducirDatos->Execute();
		datosValidados = false;
	}
}

