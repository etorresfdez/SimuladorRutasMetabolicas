				if (m->getReaction()->getDirectionString() == "BI")
					MemoSalidaValidacion->Lines->Add(m->getReaction()->getShortName() + "_i = " + m->getInverseRateShow());
			}
		}
		else // muestra solo la ecuacion de la reaccion seleccionada
		{
			// mecanismo asociado a la reaccion seleccionada
			const TMechanism* mech = model.givesMechanism(key);

			// muestra la ecuacion cinetica de la reaccion seleccionada
			MemoSalidaValidacion->Lines->Add("----------------------------------------------------------");
			MemoSalidaValidacion->Lines->Add("Reacción '" + key + "' : " + mech->getMechType());
			MemoSalidaValidacion->Lines->Add(key + "_d = " + mech->getDirectRateShow());
			if (model.findReaction(key)->getDirectionString() == "BI")
				MemoSalidaValidacion->Lines->Add(key + "_i = " + mech->getInverseRateShow());
		}
    }
}


