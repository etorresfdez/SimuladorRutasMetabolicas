void __fastcall TForm1::BtnLanzarSimulacionClick(TObject *Sender)
{
	// comprobaciones previas
	if (!datosValidados)
	{
		DialogPrimeroValida->Execute();
	}
	else
	{
		// inicia cronometro
		TStopwatch cronometro = TStopwatch::StartNew();

		// limpia salida de texto de la simulacion
		MemoSalidaSimTexto->Clear();

		// borra contenido de la tabla
		StringGrid->ColCount = 1;
		StringGrid->RowCount = 1;
		StringGrid->Cells[0][0] = "";

		// borra la imagen
		ImageGrafica->Visible = false;
		Application->ProcessMessages();

		// actualiza parametros simulacion desde los Spin
		simulation.setInitialTime(SpinTiempoInicial->Value);
		simulation.setFinalTime(SpinTiempoFinal->Value);
		simulation.setCicles(SpinCiclos->Value);
		simulation.setNumericMethod(simulation.getNumericMethodFromString(ComboEleccionMetodo->Text));

		// actualiza vectores de datos necesarios para la simulacion desde el modelo cargado
		simulation.setConcenNames(model.getAllMetaboliteNames());
		simulation.setInitialConcen(model.getAllInitialConcen());
		simulation.setEquations(model.getAllEquationsPython());
		simulation.setParameters(model.getAllParameters());

		// mensaje de aviso al usuario
		MemoSalidaSimTexto->Lines->Text = "Iniciando simulación...";
		MemoSalidaSimTexto->Lines->Add("Espere mientras termina la ejecución.");

		// punto decimal
		TFormatSettings fs;
		fs.DecimalSeparator = '.';

		try
		{
			// lanza la simulacion
			simulation.runSimulation();

			// carga tabla
			simulation.createTableResults(StringGrid);

			// carga grafica
			ImageGrafica->Picture->LoadFromFile("grafico.png");
			ImageGrafica->Visible = true;

			// para el cronometro y extrae los segundos/minutos empleados
			cronometro.Stop();
			double segundos = cronometro.Elapsed.TotalSeconds;
			double minutos = cronometro.Elapsed.TotalMinutes;
			String tiempoStr = FloatToStrF(segundos, ffFixed, 15, 2, fs) + " segundos";
			if(segundos > 120) tiempoStr = FloatToStrF(minutos, ffFixed, 15, 2, fs) + " minutos";

			// informacion de finalizacion
			MemoSalidaSimTexto->Lines->Add("Simulación terminada en " + tiempoStr + ".");
			MemoSalidaSimTexto->Lines->Add("Puedes consultar la evolución de las concentraciones en la tabla y gráfica inferiores.");

            // borra archivos generados
			DeleteFile("input.csv");
            Sleep(500); // ms
			DeleteFile("output.csv");
		}
		catch (Exception &e)
		{
			// muestra excepcion en el texto de salida simulacion texto
			MemoSalidaSimTexto->Lines->Text = e.Message;
		}
	}
}
