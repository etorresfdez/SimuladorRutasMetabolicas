TMassAction::TMassAction(String line, TModel* p_model)
    : TMechanism(line, p_model)
{
	mechanismType = LEY_ACCION_MASAS;

	// comprueba los elementos leidos, segun la ley de accion de masas
	CheckElements();

	// genera las ecuaciones cineticas adecuadas
	setDirectRatePython();
	setDirectRateShow();
	setInverseRatePython();
	setInverseRateShow();
}

void TMassAction::CheckElements() const
{
	// comprueba el numero de parametros segun si la reaccion es BI o UNI
	if((getReaction()->getDirectionString() == "BI") && (getNMechParams() != 2))
		throw Exception(getMechType() + " para una reacción BI necesita: [kdirecta, kinversa].");
	else if ((getReaction()->getDirectionString() == "UNI") && (getNMechParams() != 1))
		throw Exception(getMechType() + " para una reacción UNI necesita: [kdirecta].");

	// los parametros deben existir en el modelo
	for (int i = 0; i < getNMechParams(); i++)
		if(!model->findParameter(getMechParams(i)))
			throw Exception("'" + getMechParams(i) + "' no está registrado como PARAMETER en el modelo.");
}

String TMassAction::buildRateEquation(bool isPython, bool isDirect)
{
	String rate = "";

    // define variables segun la direccion de la ecuacion
	int index = 0;
	int n = getReaction()->getNReactants();

	if (!isDirect)
	{
		index = 1;
		n = getReaction()->getNProducts();
	}

	// parametro
	if(isPython)
		rate = "p[" + IntToStr(model->indexOfParameter(getMechParams(index))) + "]";
	else
		rate = getMechParams(index);

	// concentraciones
    for (int i = 0; i < n; i++)
	{
        double coeff;
		String name;
        int index;

		if(isDirect) 	// reactivos
		{
			coeff = getReaction()->getReactant(i).coefficient;
			name  = getReaction()->getReactant(i).substance->getShortName();
		}
		else 			// productos
        {
            coeff = getReaction()->getProduct(i).coefficient;
            name  = getReaction()->getProduct(i).substance->getShortName();
		}

		if (isPython)   // ponerlo en forma de vector con indices
        {
			index = model->indexOfMetabolite(name);
			if (coeff == 1)
				rate += "*x[" + IntToStr(index) + "]";
			else
				rate += "*x[" + IntToStr(index) + "]**" + coeff;

        }
		else           // formato salida para el usuario, con nombres de los metabolitos/params
		{
			if (coeff == 1)
				rate += "* [" + name + "]";
			else
				rate += "* [" + name + "]^" + coeff;
		}
	}

    return rate;
}

void TMassAction::setDirectRatePython()
{
	directRatePython = buildRateEquation(true, true);
}

void TMassAction::setDirectRateShow()
{
	directRateShow = buildRateEquation(false, true);
}

void TMassAction::setInverseRatePython()
{
	if(getReaction()->getDirectionString() == "BI")
		inverseRatePython = buildRateEquation(true, false);
	else
		inverseRatePython = "";
}

void TMassAction::setInverseRateShow()
{
	if(getReaction()->getDirectionString() == "BI")
		inverseRateShow = buildRateEquation(false, false);
	else
		inverseRateShow = "";
}

