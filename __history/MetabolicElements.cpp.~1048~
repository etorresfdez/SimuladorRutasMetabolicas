// Constructores
TMetabolite::TMetabolite(String p_shortName, String p_fullName, double p_initialValue)
{
	shortName = p_shortName;
    fullName = p_fullName;
	initialValue = p_initialValue;
}

TMetabolite::TMetabolite(String line)
{
	TStringList* fields = new TStringList();

    // separa la linea de entrada por tabuladores
    fields->StrictDelimiter = true;
    fields->Delimiter = '\t';
    fields->DelimitedText = Trim(line);

    // elimina campos vacios
	for (int i = fields->Count - 1; i >= 0; i--)
        if (Trim(fields->Strings[i]).IsEmpty())
            fields->Delete(i);

    // los metabolitos tienen 4 campos exactamente
    if (fields->Count < 4)
		throw Exception("Número de campos incorrecto para el metabolito. Estructura correcta: " + inputTemplate);

    // rellena los atributos del metabolito
    shortName = Trim(fields->Strings[1]);
    fullName = Trim(fields->Strings[2]);
	initialValue = StrToFloatDot(Trim(fields->Strings[3]));

    // elimina el puntero creado
	delete fields;
}

