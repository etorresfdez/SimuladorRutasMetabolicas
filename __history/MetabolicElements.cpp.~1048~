TMechanism TModel::CreateMechanism(String line, TModel* model)
{
	// separa la linea por tabuladores
	TStringList* tmp = new TStringList();
	tmp->StrictDelimiter = true;
	tmp->Delimiter = '\t';
	tmp->DelimitedText = Trim(line);

	// Coge el segundo campo despues de MECHANISM
	String type = Trim(tmp->Strings[1]);

	try
	{
		if (type == "LEY-ACCION-MASAS") return TMassAction(line, model);
		if (type == "MM-UNI-INHIBIDOR") return TMMUniInhibidor(line, model);
		if (type == "MM-BI-SEC-ALEATORIO") return TMMBiSecAleatorio(line, model);
		if (type == "MM-UNI-BI-INHIBIDOR") return TMMUniBiInhibidor(line, model);
		if (type == "MM-BI-BI-INHIBIDOR") return TMMBiBiInhibidor(line, model);
		if (type == "HILL-INHIBIDOR-ACTIVADOR") return THillInhibidorActivador(line, model);

		throw Exception("Tipo de mecanismo no válido. Son válidos: "
				"'LEY-ACCION-MASAS', "
				"'MM-UNI-INHIBIDOR', "
				"'MM-BI-SEC-ALEATORIO', "
				"'MM-UNI-BI-INHIBIDOR', "
				"'MM-BI-BI-INHIBIDOR', "
				"'HILL-INHIBIDOR-ACTIVADOR'."
		);
	}
	__finally
	{
		delete tmp;
    }
}

const TMechanism* TModel::givesMechanism(String nameReaction) const
{
    // recorre los mecanismos
	for (int i = 0; i < getNMechanisms(); i++)
        // si coincide el nombre
		if(mechanisms[i].getReactionName() == nameReaction)
			return &mechanisms[i];

	return nullptr;
}


void TModel::BuildEquations()
{
	// limpia las ecuaciones
	equationsPython.clear();
	equationsShow.clear();
	equationsShowCondensed.clear();

	// para cada metabolito
	for (int i = 0; i < getNMetabolites(); i++)
	{
		String equationS = "";
		String equationP = "";
        String equationSC = "";

		// recorre todas la reacciones
		for (int j = 0; j < getNReactions(); j++)
		{
			// recorre los reactivos
			for (int r = 0; r < reactions[j].getNReactants(); r++)
			{
				// si aparece como reactivo
				if (metabolites[i].getShortName() == reactions[j].getReactant(r).substance->getShortName())
				{
					// restamos la ecuacion cinetica directa
					equationP  += " - " + givesMechanism(reactions[j].getShortName())->getDirectRatePython();
					equationS  += " - " + givesMechanism(reactions[j].getShortName())->getDirectRateShow();
					equationSC += " - " + givesMechanism(reactions[j].getShortName())->getReactionName() + "_d";

                    // sumamos la ecuacion cinetica inversa, en caso de que sea bidireccional
					if (reactions[j].getDirectionString() == "BI")
					{
						equationP  += " + " + givesMechanism(reactions[j].getShortName())->getInverseRatePython();
						equationS  += " + " + givesMechanism(reactions[j].getShortName())->getInverseRateShow();
						equationSC += " + " + givesMechanism(reactions[j].getShortName())->getReactionName() + "_i";
					}
				}
			}

			// recorre los productos
			for (int r = 0; r < reactions[j].getNProducts(); r++)
			{
				// si aparece como producto
				if (metabolites[i].getShortName() == reactions[j].getProduct(r).substance->getShortName())
				{
					// sumamos la ecuacion cinetica directa
					equationP  += " + " + givesMechanism(reactions[j].getShortName())->getDirectRatePython();
					equationS  += " + " + givesMechanism(reactions[j].getShortName())->getDirectRateShow();
					equationSC += " + " + givesMechanism(reactions[j].getShortName())->getReactionName() + "_d";

					// restamos la ecuacion cinetica inversa, en caso de que sea bidireccional
					if (reactions[j].getDirectionString() == "BI")
					{
						equationP  += " - " + givesMechanism(reactions[j].getShortName())->getInverseRatePython();
						equationS  += " - " + givesMechanism(reactions[j].getShortName())->getInverseRateShow();
						equationSC += " - " + givesMechanism(reactions[j].getShortName())->getReactionName() + "_i";
                    }
				}
			}
		}

        // aniadimos la ecuacion del metabolito
		equationsPython.push_back(equationP);
		equationsShow.push_back(equationS);
        equationsShowCondensed.push_back(equationSC);
	}
}

