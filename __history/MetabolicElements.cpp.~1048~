// Mostrar el objeto reaccion
void TReaction::toString(TMemo* pantallaSalida) const
{
    if (!pantallaSalida)
        return;

	pantallaSalida->Lines->Add("========= REACTION =========");
    pantallaSalida->Lines->Add("Short name: " + shortName);
    pantallaSalida->Lines->Add("Full name: " + fullName);
    pantallaSalida->Lines->Add("Direction: " + getDirectionString());

	pantallaSalida->Lines->Add("Reactants: ");
	for (int i = 0; i < getNReactants(); i++)
		pantallaSalida->Lines->Add(getReactant(i).substance->getShortName() + " (" + getReactant(i).coefficient + ")");

	pantallaSalida->Lines->Add("Products: ");
	for (int i = 0; i < getNProducts(); i++)
		pantallaSalida->Lines->Add(getProduct(i).substance->getShortName() + " (" + getProduct(i).coefficient + ")");

	pantallaSalida->Lines->Add("==========================");
}

