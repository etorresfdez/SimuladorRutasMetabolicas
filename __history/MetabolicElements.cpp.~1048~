// Metodos Validacion:
// busca el nombre de un metabolito en la lista de metabolitos leidos del modelo
const TMetabolite* TModel::findMetabolite(String name) const
{
	// recorre el vector de metabolitos registrados en el modelo
	for (auto& m : metabolites)
		if (m.getShortName() == name)
			return &m;

	throw Exception("'"+ name + "' no registrado como METABOLITE.");
}

// busca el nombre de un parametro en la lista de parametros leidos del modelo
const TParameter* TModel::findParameter(String name) const
{
	// recorre el vector de parametros registrados en el modelo
	for (auto& p : parameters)
		if (p.getShortName() == name)
			return &p;

	throw Exception("'"+ name + "' no registrado como PARAMETER.");
}

// busca el nombre de una reaccion en la lista de reacciones leidas del modelo
const TReaction* TModel::findReaction(String name) const
{
	// recorre el vector de reacciones registradas en el modelo
	for (auto& r : reactions)
		if (r.getShortName() == name)
			return &r;

	throw Exception("'"+ name + "' no registrada como REACTION.");
}

// Metodos para obtener el indice del metabolito y parametro a traves del nombre
int TModel::indexOfMetabolite(String name) const
{
	int index = -1;

	// recorre el vector de metabolitos registrados en el modelo
	for (int i = 0; i < metabolites.size(); i++)
		if (metabolites[i].getShortName() == name)
			index = i;

	return index;
}

int TModel::indexOfParameter(String name) const
{
	int index = -1;

	// recorre el vector de parametros registrados en el modelo
	for (int i = 0; i < parameters.size(); i++)
		if (parameters[i].getShortName() == name)
			index = i;

	return index;
}


// Borra el contenido del modelo, reiniciandolo
void TModel::Clear()
{
    metabolites.clear();
    parameters.clear();
	reactions.clear();
    mechanisms.clear();
}


