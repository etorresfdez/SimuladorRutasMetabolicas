    // construye la ecuacion cinetica por partes: numerador y denominador
	directRatePython = "(p[" + IntToStr(model->indexOfParameter(getMechParams(0))) + "] *" +
					    "x[" + IntToStr(model->indexOfMetabolite(getReaction()->getReactant(0).substance->getShortName())) + "])";
