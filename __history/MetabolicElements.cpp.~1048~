void TMMBiSecAleatorio::CheckElements() const
{
	// comprueba el numero de parametros
	if((getReaction()->getDirectionString() == "BI") && (getNMechParams() != 4) && (getNMechParams() != 5))
		throw Exception(getMechType() + " para una reacción BI necesita: [Vmax, KmA, KmB, (KdA), Keq].");
	else if((getReaction()->getDirectionString() == "UNI") && (getNMechParams() != 3) && (getNMechParams() != 4))
		throw Exception(getMechType() + " para una reacción UNI necesita: [Vmax, KmA, KmB, (KdA)].");

	// los parametros deben existir en el modelo
	for (int i = 0; i < getNMechParams(); i++)
		if(!model->findParameter(getMechParams(i)))
			throw Exception("'" + getMechParams(i) + "' no está registrado como PARAMETER en el modelo.");
}

String TMMBiSecAleatorio::BuildDenominator(bool isPython)
{
	String denominador = "";

    // nombres cortos de los reactivos que participan
	String nameA = getReaction()->getReactant(0).substance->getShortName();
	String nameB = getReaction()->getReactant(1).substance->getShortName();

	// indices de los metabolitos y parametros para el formato python
	int A = model->indexOfMetabolite(nameA);
	int B = model->indexOfMetabolite(nameB);
	int KmA = model->indexOfParameter(getMechParams(1));
	int KmB = model->indexOfParameter(getMechParams(2));
	int KdA = -1;

	if (isPython) // formato python
	{
		denominador = "x[" + IntToStr(A) + "]*x[" + IntToStr(B) + "]" +
				   " + p[" + IntToStr(KmA) + "]*x[" + IntToStr(B) + "]" +
				   " + p[" + IntToStr(KmB) + "]*x[" + IntToStr(A) + "]";

		// distingue caso constante de disociacion
		if (getNMechParams()>3 && getReaction()->getDirectionString() == "UNI")
		{
			KdA = model->indexOfParameter(getMechParams(3));
			denominador += " + p[" + IntToStr(KdA) + "]*p[" + IntToStr(KmB) + "]";
        }
		else
			denominador += " + p[" + IntToStr(KmA) + "]*p[" + IntToStr(KmB) + "]";
	}
	else // formato salida para el usuario
	{
		denominador = "[" + nameA + "]*[" + nameB + "]" +
					" + " + getMechParams(1) + "*[" + nameB + "]" +
					" + " + getMechParams(2) + "*[" + nameA + "]";

		// distingue caso constante de disociacion
		if (getNMechParams()>3 && getReaction()->getDirectionString() == "UNI")
			denominador += " + " + getMechParams(3) + "*" + getMechParams(2);
		else
			denominador += " + " + getMechParams(1) + "*" + getMechParams(2);
    }

	return denominador;
}

void TMMBiSecAleatorio::setDirectRatePython()
{
    // indices de los metabolitos y parametros para el formato python
	int A = model->indexOfMetabolite(getReaction()->getReactant(0).substance->getShortName());
	int B = model->indexOfMetabolite(getReaction()->getReactant(1).substance->getShortName());
	int Vmax = model->indexOfParameter(getMechParams(0));

	// construye numerador con reactivos
	directRatePython = "(p[" + IntToStr(Vmax) + "]*" +
						"x[" + IntToStr(A) + "]*"
					    "x[" + IntToStr(B) + "])";

    // construye denominador
	directRatePython += "/ (" + BuildDenominator(true) + ")";
}

void TMMBiSecAleatorio::setDirectRateShow()
