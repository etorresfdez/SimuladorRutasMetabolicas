// Constructor
TModel::TModel()
{
    // metodo privado para inicializar la plantilla de tipos de mecanismos
	initMechanismTemplates();
}

void TModel::initMechanismTemplates()
{
    // completa la clave-valor de cada tipo de mecanismo disponible (6)
	mechanismTemplates =
	{
        {
			"LEY-ACCION-MASAS",
			"MECANISMO\tLEY-ACCION-MASAS\t<nombre_reaccion>\t[kdirecta, (kinversa)]"
        },
        {
			"MM-UNI-INHIBIDOR",
			"MECANISMO\tMM-UNI-INHIBIDOR\t<nombre_reaccion>\t[Vmax, KmA, KmI, Inhibidor, (Keq)]"
        },
        {
			"MM-BI-SEC-ALEATORIO",
			"MECANISMO\tMM-BI-SEC-ALEATORIO\t<nombre_reaccion>\t[Vmax, KmA, KmB, (KdA), (Keq)]"
        },
        {
			"MM-UNI-BI-INHIBIDOR",
			"MECANISMO\tMM-UNI-BI-INHIBIDOR\t<nombre_reaccion>\t[Vmax, VmaxInv, KmA, KmC, KmD, KmI, Keq, Inhibidor]"
		},
		{
			"MM-BI-BI-INHIBIDOR",
			"MECANISMO\tMM-BI-BI-INHIBIDOR\t<nombre_reaccion>\t[Vmax, KmA, KmB, KmC, KmD, (Keq)]"
		},
		{
			"HILL-INHIBIDOR-ACTIVADOR",
			"MECANISMO\tHILL-INHIBIDOR-ACTIVADOR\t<nombre_reaccion>\t[Vmax, KmA, cte, A, Inhibidor, Activador]"
		}
    };
}

String TModel::getMechanismTemplate(const String& key)
{
	// busca el elemento del mapa con la clave dada
	std::map<String, String>::iterator it = mechanismTemplates.find(key);

    // devuelve el valor asociado a esa clave (plantilla del mecanismo concreto)
	if(it != mechanismTemplates.end())
		return it->second;

    return "";
}

void TModel::fillMechanismComboBox(TComboBox* combo)
{
	// limpia el objeto combo
	combo->Items->Clear();

	// recorre el mapa mechanismTemplates para añadir cada clave al objeto combo
	for(const std::pair<String, String>& p : mechanismTemplates)
		combo->Items->Add(p.first);

	// formato downlist
	combo->Style = csDropDownList;
}

void TModel::fillReactionsComboBox(TComboBox* combo)
{
	// limpia el objeto combo
	combo->Items->Clear();

	// aniade opcion de todas las reacciones
    combo->Items->Add("Todas");

	// recorre el vector de reacciones para añadir el nombre corto de cada reaccion
	for(int i=0; i<getNReactions(); i++)
		combo->Items->Add(getReaction(i)->getShortName());

	// formato downlist
	combo->Style = csDropDownList;
}

