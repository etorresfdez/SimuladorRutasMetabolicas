		inverseRatePython = "(p[" + IntToStr(Vmax) + "]/p[" + IntToStr(Keq) +"] " +
							"*x[" + IntToStr(C) + "]*x[" + IntToStr(D) + "])";

		// denominador
		inverseRatePython += "/ (" + BuildDenominator(true) + ")";
