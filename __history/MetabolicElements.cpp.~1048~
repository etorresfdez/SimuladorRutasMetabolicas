		int Vmax = model->indexOfParameter(getMechParams(0));
		int Keq = model->indexOfParameter(getMechParams(getNMechParams()-1));

		// construye numerador con productos
		inverseRatePython = "(p[" + IntToStr(Vmax) + "]/"
							 "p[" + IntToStr(Keq) + "] *" +
							 "x[" + IntToStr(C) + "]*"
							 "x[" + IntToStr(D) + "])";

        // construye denominador con Keq
		inverseRatePython += "/(" + BuildDenominator(false) + ")";
