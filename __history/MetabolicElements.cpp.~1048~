String TMMUniBiInhibidor::BuildDenominator(bool isPython)
{
	String denominador = "";

    // nombres cortos de los reactivos/productos que participan
	String nameA = getReaction()->getReactant(0).substance->getShortName();
	String nameC = getReaction()->getProduct(0).substance->getShortName();
	String nameD = getReaction()->getProduct(1).substance->getShortName();

	// indices de los metabolitos y parametros para el formato python
	int I       = model->indexOfMetabolite(getMechParams(getNMechParams()-1));
	int A       = model->indexOfMetabolite(nameA);
	int C       = model->indexOfMetabolite(nameC);
	int D       = model->indexOfMetabolite(nameD);
	int Vmax    = model->indexOfParameter(getMechParams(0));
	int VmaxInv = model->indexOfParameter(getMechParams(1));
	int KmA     = model->indexOfParameter(getMechParams(2));
	int KmC     = model->indexOfParameter(getMechParams(3));
	int KmD     = model->indexOfParameter(getMechParams(4));
	int KmI     = model->indexOfParameter(getMechParams(5));
	int Keq     = model->indexOfParameter(getMechParams(6));

	if (isPython) // formato python
	{
		denominador = "p[" + IntToStr(KmA) + "] + x[" + IntToStr(A) + "] + " +
					  "(p[" + IntToStr(KmD) + "]*p[" + IntToStr(Vmax) + "])/" +
					  "(p[" + IntToStr(Keq) + "]*p[" + IntToStr(VmaxInv) + "]) *x[" + IntToStr(C) + "] + " +
					  "(p[" + IntToStr(KmC) + "]*p[" + IntToStr(Vmax) + "])/" +
					  "(p[" + IntToStr(Keq) + "]*p[" + IntToStr(VmaxInv) + "]) *x[" + IntToStr(D) + "] + " +
					   "p[" + IntToStr(Vmax) + "]/(p[" + IntToStr(Keq) + "]*p[" + IntToStr(VmaxInv) + "]) *" +
					   "x[" + IntToStr(C) + "]*x[" + IntToStr(D) + "] + " +
					  "(x[" + IntToStr(A) + "]*x[" + IntToStr(I) + "])/p[" + IntToStr(KmI) + "]";
	}
	else // formato salida para el usuario
	{
		denominador = getMechParams(2) + " + [" + nameA + "] + " +
					  "(" + getMechParams(4) + "*" + getMechParams(0) + ")/" +
					  "(" + getMechParams(6) + "*" + getMechParams(1) + ") *[" + nameC + "] + " +
					  "(" + getMechParams(3) + "*" + getMechParams(0) + ")/" +
					  "(" + getMechParams(6) + "*" + getMechParams(1) + ") *[" + nameD + "] + " +
					   "" + getMechParams(0) + "/(" + getMechParams(6) + "*" + getMechParams(1) + ") *" +
					   "[" + nameC + "]*[" + nameD + "] + " +
					  "([" + nameA + "]*[" + getMechParams(getNMechParams()-1) + "])/" + getMechParams(5);
    }

	return denominador;
}


