// Funciones auxiliares
void TReaction::DividesCoeffMetabolite(String text, String& name, double& coeff)
{
    // por defecto, el nombre del metabolito es el contenido de text
	text = Trim(text);
	name = text;

    // coeficiente estequiometrico por defecto
	coeff = 1.0;

	// si el nombre temporal del metabolito tiene un parentesis, tiene un coef != 1
    // y se debe separar del nombre
	if (text.Length() > 2 && text[1] == '(')
    {
        int pos = text.Pos(")");

        if (pos > 0)
		{
			// extrae el numero del coeficiente
			String coeffText = text.SubString(2, pos - 2);
			coeff = StrToFloatDot(coeffText);

            // extrae el nombre del metabolito
			name = Trim(text.SubString(pos + 1, text.Length() - pos));

			return;
		}
		else
		{
			throw Exception("Coeficiente estequimétrico mal introducido. Paréntesis desemparejado.");
        }
	}
}

void TReaction::ReadsSubstances(String s, String label)
{
	// s contiene un string con formato tipo "[A, (2)B, C]"
	// valida los corchetes
	int open = s.Pos("[");
	int close = s.Pos("]");

	if (open == 0 || close == 0 || close < open)
		throw Exception("Corchetes desemparejados en lista de " + label + ".");

	s = s.SubString(open + 1, close - open - 1);

	// divide la cadena por las comas
	TStringList* tmp = new TStringList();
	tmp->StrictDelimiter = true;
	tmp->Delimiter = ',';
	tmp->DelimitedText = s;

	// elimina espacios en blanco iniciales y finales para cada metabolito
	for (int i = 0; i < tmp->Count; i++)
		tmp->Strings[i] = Trim(tmp->Strings[i]);

	// si no se han detectado metabolitos, lanza excepcion
	if (tmp->Count == 0)
		throw Exception("No se han introducido " + label + " para la reacción.");

	// distingue entre reactivos y productos
	if (label == "reactivos")
	{
		reactants.clear();

		// para cada reactivo, guarda los coeficientes y nombre por separado
		for (int i = 0; i < tmp->Count; i++)
		{
			String reactivo;
			double coeff;

			DividesCoeffMetabolite(tmp->Strings[i], reactivo, coeff);

			// crea objeto sustancia con objeto TMetabolite y coeficiente double
			TSubstance substance = {model->findMetabolite(reactivo), coeff};
			reactants.push_back(substance);
		}
	}
	else if (label == "productos")
	{
		products.clear();

		// para cada producto, guarda los coeficientes y nombre por separado
		for (int i = 0; i < tmp->Count; i++)
		{
			String producto;
			double coeff;

			DividesCoeffMetabolite(tmp->Strings[i], producto, coeff);

			TSubstance substance = {model->findMetabolite(producto), coeff};
			products.push_back(substance);
		}
	}

    // elimina puntero temporal
	delete tmp;
}

// Constructores
TReaction::TReaction(String p_shortName, String p_fullName, TReactionDirection p_sentido,
				  const std::vector<TSubstance>& p_reactants, const std::vector<TSubstance>& p_products,
				  TModel* p_model)
{
    shortName = p_shortName;
    fullName = p_fullName;
	sentido = p_sentido;
	reactants = p_reactants;
	products = p_products;
    model = p_model;
}

TReaction::TReaction(String line, TModel* p_model)
{
	// inicializa el modelo
	model = p_model;

	// inicializa los distintos campos leyendo la linea:
	TStringList* fields = new TStringList();

	// separa la linea por tabuladores
	fields->StrictDelimiter = true;
	fields->Delimiter = '\t';
	fields->DelimitedText = Trim(line);

	// elimina campos vacios
	for (int i = fields->Count - 1; i >= 0; i--)
		if (Trim(fields->Strings[i]).IsEmpty())
			fields->Delete(i);

	// una reaccion tiene exactamente 6 campos
	if (fields->Count < 6)
		throw Exception("Número de campos incorrecto para la reacción. Estructura correcta: " + inputTemplate);

	// rellena atributos basicos
	shortName = Trim(fields->Strings[1]);
	fullName = Trim(fields->Strings[2]);

	// el sentido es un enumerado, solo tiene dos posibilidades: 'UNI' o 'BI'
	String dir = UpperCase(Trim(fields->Strings[4]));

	if (dir == "UNI")
		sentido = rdUNI;
	else if (dir == "BI")
		sentido = rdBI;
	else
		throw Exception("Sentido de reacción no válido. Valores posibles: 'BI', 'UNI'.");

	// lee los reactivos y productos
	ReadsSubstances(Trim(fields->Strings[3]), "reactivos");
	ReadsSubstances(Trim(fields->Strings[5]), "productos");

	// elimina puntero de los campos
	delete fields;
}

