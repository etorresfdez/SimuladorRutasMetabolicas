// variables estaticas
const String TMechanism::inputTemplate = "MECANISMO <tipo_mecanismo> <nombre_reaccion> <parametros_del_mecanismo>";


// Constructor
TMechanism::TMechanism(String line, TModel* p_model)
{
    // inicializa el modelo
	model = p_model;

	// inicializa los distintos campos leyendo la linea:
	TStringList* fields = new TStringList();

	// separa la linea por tabuladores
	fields->StrictDelimiter = true;
	fields->Delimiter = '\t';
	fields->DelimitedText = Trim(line);

	// elimina campos vacios
	for (int i = fields->Count - 1; i >= 0; i--)
		if (Trim(fields->Strings[i]).IsEmpty())
			fields->Delete(i);

	// un mecanismo tiene exactamente 4 campos
	if (fields->Count < 4)
		throw Exception("Número de campos incorrecto para el mecanismo. Estructura correcta: " + inputTemplate);

	// lee la reaccion asociada al mecanismo
	if (model->findReaction(Trim(fields->Strings[2])))
		reactionName = Trim(fields->Strings[2]);
	else
		throw Exception(Trim(fields->Strings[2]) + " reacción no registrada como REACTION.");

	// lee los parametros del mecanismo
	String s = Trim(fields->Strings[3]);

	// valida los corchetes
	int open = s.Pos("[");
	int close = s.Pos("]");

	if (open == 0 || close == 0 || close < open)
		throw Exception("Corchetes desemparejados en lista de parámetros del mecanismo.");

	s = s.SubString(open + 1, close - open - 1);

	// divide la cadena por las comas
	TStringList* tmp = new TStringList();
	tmp->StrictDelimiter = true;
	tmp->Delimiter = ',';
	tmp->DelimitedText = s;

	// si no se han detectado params del mecanismo, lanza excepcion
	if (tmp->Count == 0)
		throw Exception("No se han introducido parámetros para el mecanismo.");
	else
        // guarda cada parametro del mecanismo en el atributo mechParams
		for (int i = 0; i < tmp->Count; i++)
			mechParams.push_back(Trim(tmp->Strings[i]));

	// elimina puntero de los campos
	delete fields;
	delete tmp;
}

