TMMUniInhibidor::TMMUniInhibidor(String line, TModel* p_model)
    : TMechanism(line, p_model)
{
	mechanismType = MM_UNI_INHIBIDOR;

    // comprueba los elementos leidos, segun la ley de accion de masas
	CheckElements();

	// genera las ecuaciones cineticas adecuadas
	setDirectRatePython();
	setDirectRateShow();
	setInverseRatePython();
	setInverseRateShow();
}

void TMMUniInhibidor::CheckElements() const
{
    // comprueba el numero de parametros
	if((getReaction()->getDirectionString() == "BI") && (getNMechParams() != 5))
		throw Exception(getMechType() + " para una reacción BI necesita: [Vmax, KmA, KmI, I, Keq].");
	else if((getReaction()->getDirectionString() == "UNI") && (getNMechParams() != 4))
		throw Exception(getMechType() + " para una reacción UNI necesita: [Vmax, KmA, KmI, I].");

	// los parametros deben existir en el modelo
	for (int i = 0; i < 3; i++)                      	// Vmax, KmA, KmI
		if(!model->findParameter(getMechParams(i)))
			throw Exception("'" + getMechParams(i) + "' no está registrado como PARAMETER en el modelo.");

	if(getReaction()->getDirectionString() == "BI")  	// Keq
		if(!model->findParameter(getMechParams(getNMechParams()-1)))
			throw Exception("'" + getMechParams(getNMechParams()-1) + "' no está registrado como PARAMETER en el modelo.");

	// el inhibidor debe ser un metabolito registrado
    if(!model->findMetabolite(getMechParams(3)))        // I
		throw Exception("'" + getMechParams(3) + "' no está registrado como METABOLITE en el modelo.");
}

String TMMUniInhibidor::BuildDenominator(bool isPython)
{
	String denominador = "";

    // nombres cortos de los metabolitos que participan
	String nameA = getReaction()->getReactant(0).substance->getShortName();  // reactivo
	String nameI = getMechParams(3); 									     // inhibidor

	// indices de los metabolitos y parametros para el formato python
	int A = model->indexOfMetabolite(nameA);
	int I = model->indexOfMetabolite(nameI);
	int KmA = model->indexOfParameter(getMechParams(1));
	int KmI = model->indexOfParameter(getMechParams(2));


	if (isPython) // formato python
	{
		denominador = "p[" + IntToStr(KmA) + "]" +
				   " + p[" + IntToStr(KmA) + "]*x[" + IntToStr(I) + "]/p[" + IntToStr(KmI) + "]" +
				   " + x[" + IntToStr(A)   + "]";
	}
	else // formato salida para el usuario
	{
		denominador = getMechParams(1) + " *(1 + [" + nameI + "]/" + getMechParams(2) + ") + [" + nameA + "]";
    }

	return denominador;
}

void TMMUniInhibidor::setDirectRatePython()
