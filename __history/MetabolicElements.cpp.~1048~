// ECUACION DE HILL CON INHIBIDOR Y ACTIVADOR __________________________________

THillInhibidorActivador::THillInhibidorActivador(String line, TModel* p_model)
    : TMechanism(line, p_model)
{
	mechanismType = HILL_INHIBIDOR_ACTIVADOR;

    // comprueba los elementos leidos, segun la ley de accion de masas
	CheckElements();

	// genera las ecuaciones cineticas adecuadas
	setDirectRatePython();
	setDirectRateShow();
	setInverseRatePython();
	setInverseRateShow();
}

void THillInhibidorActivador::CheckElements() const
{
    // solo se implementa la ecuacion de hill en reacciones unidireccionales
	if(getReaction()->getDirectionString() == "BI")
		throw Exception(getMechType() + " solo aplica a reacciones unidireccionales");

    // comprueba el numero de parametros
	if(getNMechParams() != 6)
		throw Exception(getMechType() + " necesita: [Vmax, KmA, cte, A, Inhibidor, Activador].");

	// los parametros deben existir en el modelo
	for (int i = 0; i < (getNMechParams()-3); i++)
		if(!model->findParameter(getMechParams(i)))
			throw Exception("'" + getMechParams(i) + "' no está registrado como PARAMETRO en el modelo.");

	// el reactivo/inhibidor/activador deben ser metabolitos en el modelo
	if(!model->findMetabolite(getMechParams(getNMechParams()-1)))
		throw Exception("El activador '" + getMechParams(getNMechParams()-1) + "' no está registrado como METABOLITO en el modelo.");
	if(!model->findMetabolite(getMechParams(getNMechParams()-2)))
		throw Exception("El inhibidor '" + getMechParams(getNMechParams()-2) + "' no está registrado como METABOLITO en el modelo.");
    if(!model->findMetabolite(getMechParams(getNMechParams()-3)))
		throw Exception("El reactivo '" + getMechParams(getNMechParams()-3) + "' no está registrado como METABOLITO en el modelo.");
}

void THillInhibidorActivador::setDirectRatePython()
{
	// indices de los metabolitos y parametros para el formato python
	int Vmax = model->indexOfParameter(getMechParams(0));
	int KmA  = model->indexOfParameter(getMechParams(1));
	int cte  = model->indexOfParameter(getMechParams(2));
	int A    = model->indexOfMetabolite(getMechParams(3));
	int Inh  = model->indexOfMetabolite(getMechParams(4));
	int Act  = model->indexOfMetabolite(getMechParams(5));
	int n = 2;

	// numerador
	directRatePython = "(p[" + IntToStr(Vmax) + "] *x[" + IntToStr(A) + "]**" + IntToStr(n) + ")";

	// denominador
	directRatePython += " / (p[" + IntToStr(KmA) + "] + p[" + IntToStr(KmA) + "]*p[" + IntToStr(cte) + "]* " +
						"x[" + IntToStr(Inh) + "]**" + IntToStr(n) + " / x[" + IntToStr(Act) + "]**" + IntToStr(n) + " + " +
						"x[" + IntToStr(A) + "]**" + IntToStr(n) + ")";
}

void THillInhibidorActivador::setDirectRateShow()
{
	int n = 2;

	// numerador
	directRateShow = "(" + getMechParams(0) + " *[" + getMechParams(3) + "]^" + IntToStr(n) + ")";

	// denominador
	directRateShow += " / (" + getMechParams(1) + " *(1 + " + getMechParams(2) + "* " +
						 "[" + getMechParams(4) + "]^" + IntToStr(n) + " / [" + getMechParams(5) + "]^" + IntToStr(n) + ") + " +
						 "[" + getMechParams(3) + "]^" + IntToStr(n) + ")";
}

void THillInhibidorActivador::setInverseRatePython()
{
	inverseRatePython = "";
}

void THillInhibidorActivador::setInverseRateShow()
{
    inverseRateShow = "";
}


