/**
 *  @brief struct TSubstance para agrupar el metabolito y su coeficiente que participan en una reaccion.
 */
struct TSubstance
{
	const TMetabolite* substance;    	/**< Nombre corto del metabolito. */
	double coefficient;         		/**< Coeficiente estequiometrico asociado. */
};



/**
 *  @class TReaction
 *  @brief Clase para encapsular las reacciones del modelo.
 */
class TReaction
{
	private: // private members

		String shortName;       					/**< Nombre corto de la reaccion */
		String fullName;        					/**< Nombre largo de la reaccion */
		TReactionDirection sentido; 		 		/**< Sentido de la reaccion (UNI o BI) */
		std::vector<TSubstance> reactants; 			/**< Array de reactivos de la reaccion */
		std::vector<TSubstance> products;  			/**< Array de productos de la reaccion */
		TModel* model;                              /**< Modelo al que pertenece la reaccion */

		/**
		 * @brief Dada una lista de sustancias, las separa en nombres y coeficientes estequimetricos.
		 * @param sustancias lista de sustancias con formato [A, (2)B, C], tipo String
         * @param label "reactivos" si las sustancias son reactivos, "productos" si son productos; tipo String
		 *
		 * Si label indica reactivos, rellena los atributos reactants y reactantStoichCoeffs.
		 * Si label indica productos, rellena los atributos products y productStoichCoeffs.
		 */
		void ReadsSubstances(String sustancias, String label);

		/**
		 * @brief Separa coeficiente estequiometrico del nombre del metabolito.
		 * @param text nombre temporal del metabolito extraido directamente del panel de entrada, tipo String
		 * @param name nombre del metabolito sin el coeficiente estequiometrico (parametro por referencia), tipo String
		 * @param coeff coeficiente estequiometrico del metabolito (parametro por referencia), tipo double
		 *
		 * Dado el text pasado como parametro, lo divide en coeficiente estequiometrico
		 * (coeff) y nombre del metabolito (name) en caso de que dicho metabolito tenga un
		 * coeficiente estequiometrico distinto de 1 en la reaccion. En ese caso, text tendra
		 * la forma "(2)A", con el coeficiente estequiometrico entre parentesis.
		 */
		void DividesCoeffMetabolite(String text, String& name, double& coeff);

	public:

		static const String inputTemplate; /**< Estructura de entrada de datos de una reaccion */

		/**
		 *  @brief Constructor de TReaction
		 *  @param p_shortName nombre corto de la reaccion, tipo String
		 *  @param p_fullName nombre largo de la reaccion, tipo String
		 *  @param p_sentido sentido de la reaccion (UNI o BI), tipo TReactionDirection
		 *  @param p_reactants array de reactivos de la reaccion, tipo std::vector<TSubstance>
		 *  @param p_products array de productos de la reaccion, tipo std::vector<TSubstance>
		 *  @param p_model modelo al que pertenece la reaccion, tipo puntero a TModel
		 */
		TReaction(String p_shortName, String p_fullName, TReactionDirection p_sentido,
				  const std::vector<TSubstance>& p_reactants, const std::vector<TSubstance>& p_products,
				  TModel* model);

		/**
		 * @brief Constructor de TReaction, lee una linea completa del panel de entrada
		 * @param line linea del panel de entrada asociada a una reaccion, comienza por REACTION
		 * @param model modelo al que pertenece la reaccion
		 */
		TReaction(String line, TModel* model);

        /**
		 *  @brief Devuelve el nombre corto de la reaccion
		 *  @return String nombre corto de la reaccion
		 */
		String getShortName() const;

		/**
		 *  @brief Devuelve el nombre largo del parametro
		 *  @return String nombre largo del parametro
		 */
		String getFullName() const;

		/**
		 * @brief Devuelve el sentido de la reaccion
		 * @return UNI o BI segun la reaccion sea unidireccional o bidireccional
		 */
		String getDirectionString() const;

		/**
		 * @brief Devuelve el numero de reactivos que tiene la reaccion
		 * @return numero de reactivos
		 */
		int getNReactants() const;

        /**
		 * @brief Devuelve el numero de productos que tiene la reaccion
		 * @return numero de productos
		 */
		int getNProducts() const;

		/**
		 * @brief Devuelve el nombre corto del reactivo i de la reaccion
		 * @param i indice del reactivo a devolver (empieza en 0)
		 * @return sustancia (metabolito y coef) que actua como reactivo en esta reaccion
		 */
		const TSubstance getReactant(int i) const;

		/**
		 * @brief Devuelve el nombre corto del producto i de la reaccion
		 * @param i indice del producto a devolver (empieza en 0)
		 * @return sustancia (metabolito y coef) que actua como producto en esta reaccion
		 */
		const TSubstance getProduct(int i) const;

		/**
		 *  @brief Muestra la reaccion guardada y sus atributos
		 *  @param pantallaSalida objeto de la interfaz donde se muestra
		 */
		void toString(TMemo* pantallaSalida) const;
};


/**
 *  @class TMechanism
 *  @brief Clase padre para encapsular los mecanismos asociados a cada reaccion del modelo.
 */
class TMechanism
{
	private:
		String reactionName;                /**< Nombre de la reaccion que sigue el mecanismo creado */
		std::vector<String> mechParams;     /**< Vector de los parametros asociados al mecanismo concreto de la reaccion */

	protected:
		TMechanismType mechanismType;       /**< Enumerado que indica el tipo de mecanismo */
		TModel* model;                      /**< Modelo dentro del que se incluye el mecanismo */
		String directRatePython;            /**< String que representa la ecuacion cinetica directa, formato Python */
		String directRateShow;              /**< String que representa la ecuacion cinetica directa, formato salida usuario */
		String inverseRatePython;           /**< String que representa la ecuacion cinetica inversa, formato Python */
		String inverseRateShow;             /**< String que representa la ecuacion cinetica inversa, formato salida usuario */

	public:

        static const String inputTemplate; /**< Estructura de entrada de datos de un mecanismo */

		/**
		 *  @brief Constructor de la clase TMechanism
		 *  @param line linea de entrada de datos que comienza por "MECHANISM"
         *  @param p_model modelo asociado al mecanismo
		 */
		TMechanism(String line, TModel* p_model);


        /**
		 *  @brief Devuelve el nombre del tipo de mecanismo.
		 *  @return String nombre del tipo de mecanismo.
		 */
		String getMechType() const;

		/**
		 *  @brief Devuelve el nombre de la reaccion asociada al mecanismo.
		 *  @return String nombre corto de la reaccion.
		 */
		String getReactionName() const;

		/**
		 *  @brief Devuelve un puntero a la reaccion dada su nombre.
		 */
		const TReaction* getReaction() const;

		/**
		 *  @brief Devuelve el numero de parametros del mecanismo guardados.
		 *  @return int numero de parametros del mecanismo.
		 */
		int getNMechParams() const;

		/**
		 *  @brief Devuelve el parametro del mecanismo de la posicion 'i'.
		 *  @param i indice del parametro del mecanismo que devuelve.
         *  @return String nombre corto del parametro del mecanismo, puede ser el nombre corto de un metabolito o un parametro.
		 */
		String getMechParams(int i) const;

		/**
		 *  @brief Devuelve la ecuacion cinetica directa en forma de String.
		 *  Formato para enviarla al solver de Python.
		 */
		String getDirectRatePython() const;

		/**
		 *  @brief Devuelve la ecuacion cinetica inversa en forma de String.
		 *  Formato para enviarla al solver de Python.
		 */
		String getInverseRatePython() const;

        /**
		 *  @brief Devuelve la ecuacion cinetica directa en forma de String.
		 *  Formato para mostrarla por pantalla.
		 */
		String getDirectRateShow() const;

		/**
		 *  @brief Devuelve la ecuacion cinetica inversa en forma de String.
		 *  Formato para mostrarla por pantalla.
		 */
		String getInverseRateShow() const;

        /**
		 *  @brief Muestra el mecanismo guardado y sus atributos
		 *  @param pantallaSalida objeto de la interfaz donde se muestra
		 */
		void toString(TMemo* pantallaSalida) const;


         /**
		 *  @brief Metodo virtual para comprobar que los atributos cargados en el mecanismo son correctos.
		 *  Depende del tipo de mecanismo. Lanza excepciones si no son correctos.
		 *  Se comprueba que el numero de parametros es el adecuado, y que los metabolitos y parametros mencionados estan registrados en el modelo.
		 */
		virtual void CheckElements() const;


		/**
		 *  @brief Metodo virtual para crear la ecuacion cinetica directa en forma de String.
		 *  Depende del tipo de mecanismo. Formato para enviarla al solver de python.
		 */
		virtual void setDirectRatePython();

		/**
		 *  @brief Metodo virtual para crear la ecuacion cinetica inversa en forma de String.
		 *  Depende del tipo de mecanismo. Si la reaccion es unidireccional, devuelve "".
		 *  Formato para enviarla al solver de python.
		 */
		virtual void setInverseRatePython();

		/**
		 *  @brief Metodo virtual para crear la ecuacion cinetica directa en forma de String.
		 *  Depende del tipo de mecanismo. Formato para mostrarla por pantalla.
		 */
		virtual void setDirectRateShow();

		/**
		 *  @brief Metodo virtual para crear la ecuacion cinetica inversa en forma de String.
		 *  Depende del tipo de mecanismo. Si la reaccion es unidireccional, devuelve "".
		 *  Formato para mostrarla por pantalla.
		 */
		virtual void setInverseRateShow();


		/**
		 *  @brief Destructor virtual de la clase, por defecto.
		 */
		virtual ~TMechanism() = default;
};


/**
 *  @class TMassAction
 *  @brief Representa un mecanismo que sigue la ley de accion de masas. Hereda de TMechanism.
 */
class TMassAction : public TMechanism
{
	public:

		/**
		 *  @brief Constructor de la clase TMassAction.
		 *  Llama al constructor del padre, rellena los atributos propios y hace validaciones extra concretas.
		 */
		TMassAction(String line, TModel* p_model);

        /**
		 *  @brief Construye la ecuacion cinetica segun la ley de accion de masas.
		 *  @param isPython variable bandera: true para generar ecuacion para enviarla a Python, false si es para mostrarla por pantalla
         *  @return String con la ecuacion cinetica que se pide
		 */
		String buildRateEquation(bool isPython, bool isDirect);


		/**
		 *  @brief Comprueba que se han enviado los parametros necesarios del mecanismo MassAction:
		 *  [kd, (ki)] --> entre parentesis los opcionales cuando la reaccion es bidireccional
		 *  - kd: constante de velocidad directa
		 *  - ki: constante de velocidad inversa
		 *  Los parametros tienen que estar registrados previamente en el modelo como PARAMETER-
		 */
		void CheckElements() const override;

		/**
		 *  @brief Construye la ecuacion cinetica directa de la reaccion, en formato Python.
		 *  Modifica el atributo protected "directRatePython" de la clase padre.
		 */
		void setDirectRatePython() override;

		/**
		 *  @brief Construye la ecuacion cinetica inversa de la reaccion, en formato Python.
		 *  Modifica el atributo protected "inverseRatePython" de la clase padre.
		 */
		void setInverseRatePython() override;

        /**
		 *  @brief Construye la ecuacion cinetica directa de la reaccion, en formato salida para el usuario.
		 *  Modifica el atributo protected "directRateShow" de la clase padre.
		 */
		void setDirectRateShow() override;

		/**
		 *  @brief Construye la ecuacion cinetica inversa de la reaccion, en formato salida para el usuario.
		 *  Modifica el atributo protected "inverseRateShow" de la clase padre.
		 */
		void setInverseRateShow() override;
};


/**
 *  @class TMMUniInhibidor
 *  @brief Representa un mecanismo del tipo Michaelis-Menten unisustrato con inhibicion competitiva. Hereda de TMechanism.
 */
class TMMUniInhibidor : public TMechanism
{
	public:

		/**
		 *  @brief Constructor de la clase TMMUniInhibidor.
		 *  Llama al constructor del padre, rellena los atributos propios y hace validaciones extra concretas.
		 */
		TMMUniInhibidor(String line, TModel* p_model);

        /**
		 *  @brief Construye el denominador de la ecuacion cinetica de tipo MMUniInhibidor.
		 *  @param isPython true: formato python, false: formato salida para el usuario.
		 *  @return String que contiene el denominador de la ecuacion cinetica correspondiente.
		 */
		String BuildDenominator(bool isPython);


		/**
		 *  @brief Comprueba que se han enviado los parametros necesarios del mecanismo MMUniInhibidor:
		 *  [Vmax, KmA, KmI, Inhibidor, (Keq)]
         *  - Vmax: velocidad maxima de la reaccion
		 *  - KmA: concentracion del reactivo A para la cual se consigue la mitad de la velocidad max cuando la enzima esta saturada
		 *  - KmI: concentracion del inhibidor I para la cual se consigue la mitad de la velocidad max cuando la enzima esta saturada
		 *  - I: metabolito que actua como inhibidor en esta reaccion
		 *  - Keq: constante de equilibrio
		 *  Todos los parametros y metabolitos mencionados tienen que estar registrados en el modelo.
		 */
		void CheckElements() const override;


		/**
		 *  @brief Construye la ecuacion cinetica directa de la reaccion, en formato Python.
		 *  Modifica el atributo protected "directRatePython" de la clase padre.
		 */
		void setDirectRatePython() override;

		/**
		 *  @brief Construye la ecuacion cinetica inversa de la reaccion, en formato Python.
		 *  Modifica el atributo protected "inverseRatePython" de la clase padre.
		 */
		void setInverseRatePython() override;

        /**
		 *  @brief Construye la ecuacion cinetica directa de la reaccion, en formato salida para el usuario.
		 *  Modifica el atributo protected "directRateShow" de la clase padre.
		 */
		void setDirectRateShow() override;

		/**
		 *  @brief Construye la ecuacion cinetica inversa de la reaccion, en formato salida para el usuario.
		 *  Modifica el atributo protected "inverseRateShow" de la clase padre.
		 */
		void setInverseRateShow() override;
};

