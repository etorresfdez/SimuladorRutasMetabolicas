/**
 *  @class TModel
 *  @brief Clase para encapsular un modelo completo, que representa una ruta metabolica especifica.
 */
class TModel
{
	private: // private members

		std::vector<TMetabolite> metabolites;			/**< Lista de los metabolitos que componen el modelo, cuya concentracion se va a medir en lal simulacion */
		std::vector<TParameter> parameters;     		/**< Lista de todos los parametros que aparecen en el modelo */
		std::vector<TReaction> reactions;    			/**< Lista de las reacciones que componen el modelo a simular */
		std::vector<TMechanism> mechanisms;    			/**< Lista de los mecanismos que componen el modelo a simular. Uno para cada reaccion. */
		std::vector<String> equationsPython;    		/**< Lista de las EDOs que miden la variacion de la concentracion de cada metabolito a lo largo del tiempo. Formato Python. */
		std::vector<String> equationsShow;      		/**< Lista de las EDOs que miden la variacion de la concentracion de cada metabolito a lo largo del tiempo. Formato para salida usuario. */
		std::vector<String> equationsShowCondensed;     /**< Muestra el nombre del mecanismo que se suma o resta, no la ecuacion cineta desglosada como en equationsShow . */
		std::map<String, String> mechanismTemplates;	/**< Mapa con los tipos de mecanismo disponibles en la aplicacion, junto a su plantilla de entrada */

		/**
		 *  @brief Inicializa el mapa mechanismTemplates con los tipos de mecanismos disponibles en la aplicacion.
		 *  Modifica el atributo "mechanismTemplates" introduciendo parejas clave-valor:
		 *  - clave: identificativo del tipo de mecanismo, String.
		 *  - valor: plantilla con los campos necesarios para introducir un MECHANISM de ese tipo, String.
		 */
		void initMechanismTemplates();

	public:

		/**
		 *  @brief Constructor de la clase TModel.
		 *
		 *  Llama al metodo initMechanismTemplates() para inicializar el mapa de mechanismTemplates
         *  con los tipos de mecanismos disponibles en la aplicacion.
		 */
		TModel();


        /**
		 *  @brief Rellena el objeto comboReactions con la lista de las reacciones cargadas en el modelo.
		 *  @param comboReactions objeto TComboBox que contendra un desplegable con las reacciones cargadas en el modelo.
		 */
		void fillReactionsComboBox(TComboBox* comboReactions);

		/**
		 *  @brief Rellena el objeto comboMecanismos con la lista de tipos de mecanismos disponibles.
		 *  Usa el contenido del mapa mechanismTemplates de la clase.
		 *  @param comboMecanismos objeto TComboBox que contendra un desplegable con los tipos de mecanismos disponibles.
		 */
		void fillMechanismComboBox(TComboBox* comboMecanismos);

		/**
		 *  @brief Dado el tipo de mecanismo (key), devuelve la plantilla de entrada de datos asociada.
		 *  @param key tipo de mecanismo
		 *  @return String con la plantilla de entrada del tipo de mecanismo pedido
		 */
		String getMechanismTemplate(const String& key);


		/**
		 *  @brief Metodo para aniadir un metabolito al modelo.
		 *  @param metabolite referencia constante de un objeto de tipo TMetabolite que se aniade a la lista de metabolitos del modelo.
		 */
		void addMetabolite(const TMetabolite& metabolite);

        /**
		 *  @brief Metodo para aniadir un parametro al modelo.
		 *  @param parameter referencia constante de un objeto de tipo TParameter que se aniade a la lista de parametros del modelo.
		 */
		void addParameter(const TParameter& parameter);

        /**
		 *  @brief Metodo para aniadir una reaccion al modelo.
		 *  @param reaction referencia constante de un objeto de tipo TReaction que se aniade a la lista de reacciones del modelo.
		 */
		void addReaction(const TReaction& reaction);

        /**
		 *  @brief Metodo para aniadir un mecanismo al modelo.
		 *  @param reaction referencia constante de un objeto de tipo TMechanism que se aniade a la lista de mecanismos del modelo.
		 */
		void addMechanism(const TMechanism& mechanism);

		/**
		 *  @brief Dado el nombre corto de un metabolito, lo busca en el vector de metabolitos del modelo.
		 *  @param name nombre corto del metabolito a buscar.
		 *  @return Devuelve un puntero al metabolito si este se encuentra en el modelo. Lanza una excepcion en caso contrario.
		 */
		const TMetabolite* findMetabolite(String name) const;

		/**
		 *  @brief Dado el nombre corto de un parametro, lo busca en el vector de parametros del modelo.
		 *  @param name nombre corto del parametro a buscar.
		 *  @return Devuelve un puntero al parametro si este se encuentra en el modelo. Lanza una excepcion en caso contrario.
		 */
		const TParameter* findParameter(String name) const;

		/**
		 *  @brief Dado el nombre corto de una reaccion, lo busca en el vector de reacciones del modelo.
		 *  @param name nombre corto de la reaccion a buscar.
		 *  @return Devuelve un puntero a la reaccion si esta se encuentra en el modelo. Lanza una excepcion en caso contrario.
		 */
		const TReaction* findReaction(String name) const;

        /**
		 *  @brief Dado el nombre corto de una reaccion, devuelve el mecanismo cargado en el modelo que la describe.
		 *  @param name nombre corto de una reaccion.
		 *  @return Devuelve un puntero al mecanismo que describe la reaccion.
		 */
		const TMechanism* givesMechanism(String nameReaction) const;


        /**
		 *  @brief Dado el indice de un metabolito, lo busca en el vector de metabolitos del modelo.
		 *  @param i indice del metabolito a devolver.
		 *  @return Devuelve un puntero al metabolito. Devuelve nullptr si el indice es invalido.
		 */
		const TMetabolite* getMetabolite(int i) const;

		/**
		 *  @brief Dado el indice de un parametro, lo busca en el vector de parametros del modelo.
		 *  @param i indice del parametro a devolver.
		 *  @return Devuelve un puntero al parametro. Devuelve nullptr si el indice es invalido.
		 */
		const TParameter* getParameter(int i) const;

        /**
		 *  @brief Dado el indice de una reaccion, la busca en el vector de reacciones del modelo.
		 *  @param i indice del reaccion a devolver.
		 *  @return Devuelve un puntero al reaccion. Devuelve nullptr si el indice es invalido.
		 */
		const TReaction* getReaction(int i) const;

        /**
		 *  @brief Dado el indice de un mecanismo, lo busca en el vector de mecanismos del modelo.
		 *  @param i indice del mecanismo a devolver.
		 *  @return Devuelve un puntero al mecanismo. Devuelve nullptr si el indice es invalido.
		 */
		const TMechanism* getMechanism(int i) const;

		/**
		 *  @brief Devuelve el numero de metabolitos que contiene el modelo.
		 *  @return int numero de metabolitos del modelo.
		 */
		int getNMetabolites() const;

        /**
		 *  @brief Devuelve el numero de parametros que contiene el modelo.
		 *  @return int numero de parametros del modelo.
		 */
		int getNParameters() const;

        /**
		 *  @brief Devuelve el numero de reacciones que contiene el modelo.
		 *  @return int numero de reacciones del modelo.
		 */
		int getNReactions() const;

		/**
		 *  @brief Devuelve el numero de mecanismos que contiene el modelo.
		 *  @return int numero de mecanismos del modelo.
		 */
		int getNMechanisms() const;


		/**
		 *  @brief Devuelve el indice del metabolito de nombre 'name' segun el vector de metabolitos del modelo.
		 *  @param name Nombre corto del metabolito.
		 *  @return int Numero del indice del metabolito en el vector de metabolitos del modelo. Devuelve -1 si no lo encuentra.
		 */
		int indexOfMetabolite(String name) const;

        /**
		 *  @brief Devuelve el indice del parametro de nombre 'name' segun el vector de parametros del modelo.
		 *  @param name Nombre corto del parametro.
		 *  @return int Numero del indice del parametro en el vector de parametros del modelo. Devuelve -1 si no lo encuentra.
		 */
		int indexOfParameter(String name) const;


        /**
		 *  @brief Dada la linea de entrada y el modelo, crea un objeto TMechanism.
		 *  La linea empieza por MECHANISM y se crea un tipo de mecanismo u otro segun el tipo especificado en el segundo campo de la linea.
		 *  @param line linea del texto de entrada que se lee.
		 *  @param model puntero al modelo en el que se crea el mecanismo.
		 *  @return Devuelve el objeto TMechanism creado.
		 */
		TMechanism CreateMechanism(String line, TModel* model);


		/**
		 *  @brief Metodo que construye el sistema de ecuaciones diferenciales ordinarias, donde cada ecuacion mide la
		 *  variacion de la concentracion de un metabolito. Hay tantas ecuaciones como metabolitos registrados.
		 *
		 *  La forma de construirla es teniendo en cuenta si el metabolito aparece como reactivo o producto en cada reaccion.
		 *  Si aparece como reactivo, se resta la ecuacion cinetica asociada a dicha reaccion; si aparece como producto, se suma.
		 *
         *  El metodo modifica los atributos "equationsPython", "equationsShow" y "equationsShowCondensed" de la clase.
		 */
		void BuildEquations();

		/**
		 *  @brief Muestra la EDO de la posicion (i), correspondiente al metabolito (i).
		 *  @param i indice del vector de ecuaciones.
		 *  @return String EDO del metabolito numero (i), en formato String para Python.
		 */
		String getEquationPython(int i);

        /**
		 *  @brief Muestra la EDO de la posicion (i), correspondiente al metabolito (i).
		 *  @param i indice del vector de ecuaciones.
		 *  @return String EDO del metabolito numero (i), en formato String para el usuario.
		 */
		String getEquationShow(int i);

        /**
		 *  @brief Muestra la EDO condensada de la posicion (i), correspondiente al metabolito (i).
		 *  @param i indice del vector de ecuaciones.
		 *  @return String EDO del metabolito numero (i), en formato String para el usuario.
		 */
		String getEquationShowCondensed(int i);

        /**
		 *  @brief Devuelve un vector con todas las ecuaciones de los metabolitos guardados en el modelo.
		 *  @return vector constante de tipo String
		 */
		const std::vector<String>& getAllEquationsPython() const;

		/**
		 *  @brief Devuelve un vector con todos los nombres cortos de los metabolitos guardados en el modelo.
		 *  @return vector constante de tipo String
		 */
		const std::vector<String> getAllMetaboliteNames() const;

        /**
		 *  @brief Devuelve un vector con todas las concentraciones iniciales de los metabolitos guardados en el modelo.
		 *  @return vector constante de tipo double
		 */
		const std::vector<double> getAllInitialConcen() const;

        /**
		 *  @brief Devuelve un vector con todos los parametros guardados en el modelo.
		 *  @return vector constante de tipo double
		 */
		const std::vector<double> getAllParameters() const;


		/**
		 *  @brief Borra el contenido actual del modelo.
		 *  Elimina los metabolitos, parametros y reacciones cargadas.
         */
		void Clear();
};
