#include <vector>
#include <map>

/**
 * @brief enum TReactionDirection. Enumerado para representar el sentido de una reaccion.
 * Hay dos posibilidades: UNI si es unidireccional y BI si es bidireccional.
 */
enum TReactionDirection
{
	rdUNI, 	/**< La reaccion es unidireccional. */
	rdBI    /**< La reaccion es bidireccional. */
};

/**
 * @brief enum TMechanismType. Enumerado para representar el tipo de mecanismo de una reaccion.
 * Se contemplan 6 tipos de mecanismos.
 */
enum TMechanismType
{
	LEY_ACCION_MASAS, 			/**< Ley de accion de masas. */
	MM_UNI_INHIBIDOR,           /**< Michaelis-Menten unisustrato con inhibicion. */
	MM_BI_SEC_ALEATORIO,    	/**< Michaelis-Menten bisustrato secuencial aleatorio. */
	MM_UNI_BI_INHIBIDOR,        /**< Michaelis-Menten unisustrato biproducto con inhibicion. */
	MM_BI_BI_INHIBIDOR,         /**< Michaelis-Menten bisustrato biproducto con inhibicion. */
	HILL_INHIBIDOR_ACTIVADOR    /**< Ecuacion de Hill con inhibidor y activador. */
};

class TModel;



/**
 *  @class TMetabolite
 *  @brief Clase para encapsular los metabolitos del modelo.
 */
class TMetabolite
{
	private: // private members

		String shortName;       	/**< Nombre corto del metabolito */
		String fullName;        	/**< Nombre largo del metabolito */
		double initialValue;    	/**< Concentracion inicial del metabolito */

        /**
		 *  @brief Metodo que convierte un double en string con formato decimal ','
		 *  @param value numero con decimales con ','
		 *  @return String palabra que se devuelve manteniendo el formato decimal '.'
		 */
		String FloatToStrComma(double value);

	public:

		static const String inputTemplate; /**< Estructura de entrada de datos de un metabolito */

		/**
		 *  @brief Constructor de TMetabolite
		 *  @param p_shortName nombre corto del metabolito, tipo String
		 *  @param p_fullName nombre largo del metabolito, tipo String
		 *  @param p_initialValue concentracion inicial del metabolito, tipo double
		 */
		TMetabolite(String p_shortName, String p_fullName, double p_initialValue);

		/**
		 *  @brief Constructor de TMetabolite
		 *  @param line linea del panel de entrada asociada a un metabolito, comienza por METABOLITE
		 */
		TMetabolite(String line);

        /**
		 *  @brief Devuelve el nombre corto del metabolito
		 *  @return String nombre corto del metabolito
		 */
		String getShortName() const;

		/**
		 *  @brief Devuelve el nombre largo del metabolito
		 *  @return String nombre largo del metabolito
		 */
		String getFullName() const;

		/**
		 *  @brief Devuelve la concentracion inicial del metabolito
		 *  @return double concentracion inicial del metabolito
		 */
		double getInitialValue() const;

        /**
		 *  @brief Actualiza la concentracion inicial del metabolito
		 *  @param double concentracion inicial del metabolito
		 */
		void setInitialValue(double initialConcentration);

        /**
		 *  @brief Muestra el metabolito guardado y sus atributos
		 *  @param pantallaSalida objeto de la interfaz donde se muestra
		 */
		void toString(TMemo* pantallaSalida) const;
};



